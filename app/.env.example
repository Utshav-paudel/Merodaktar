# MeroDaktar Environment Configuration

# OpenAI API Configuration (Required for Medical Chat)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini API Configuration (Optional - for future voice integration)
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Database Configuration (for future use)
DATABASE_URL=sqlite:///./merodaktar.db

# JWT Secret Key (Change in production)
SECRET_KEY=your-secret-key-change-in-production

# Application Settings
DEBUG=True
ENVIRONMENT=development

# Note: 
# 1. Replace "your_openai_api_key_here" with your actual OpenAI API key
# 2. To get an OpenAI API key:
#    - Go to https://platform.openai.com/
#    - Sign up or log in
#    - Go to API Keys section
#    - Create a new API key
#    - Copy and paste it here
# 3. To get a Gemini API key:
#    - Go to https://makersuite.google.com/app/apikey
#    - Sign in with your Google account
#    - Create a new API key
#    - Copy and paste it here
